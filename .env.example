# 示例配置。仓库里已生成可直接使用的 .env（权限 600，被 .gitignore 忽略，不要提交）。
# 完整部署步骤见 ./deploy.md —— Go 版本机直接启动，不需要 Docker。
# 若 .env 丢失，复制本文件为 .env，并把 DATABASE_URL / JWT_SECRET 与 mall-api/.env 对齐。

# ★ 必须与 Node 版 mall-api 指向同一个库；表由 Prisma 迁移创建，本服务不建表
DATABASE_URL="mysql://mall:mall123@localhost:3306/mall"

# ★★ 必须与 Node 版 mall-api / PHP 版填「完全相同的值」，三套后端令牌才能互认
JWT_SECRET="replace-with-the-same-secret-as-mall-api"

# 令牌时长（与 Node 版默认值一致）
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7

# 端口：Node 3000 / PHP 3001 / Go 3002，避免本地同时启动冲突
PORT=3002

# 跨域白名单：逗号分隔；同域 Nginx 反代可留 * 或填前端域名
CORS_ORIGINS="*"

# 微信登录（可选，留空则该端点返回明确错误，账号密码登录不受影响）
WX_APPID=""
WX_SECRET=""
WX_OA_APPID=""
WX_OA_SECRET=""

# ── 图片 URL 契约（三套后端一致，详见 backend/README.md）──
# 对外 origin（协议+域名+端口，不带 /api、不带尾斜杠）：
#   留空 → 按当前请求推导（本地为 http://localhost:3002）
#   生产 / 反代 / CDN 必配；真机调试填局域网 IP，别填 localhost
PUBLIC_ORIGIN=""
# 上传目录（相对项目根）：三套后端共用 backend/uploads，
# 这样 Node/PHP 上传的图在 Go 版下也能按完整 URL 取到
UPLOAD_DIR="../uploads"

# 设为 test 时跳过登录/注册限流（跑集成测试用）
APP_ENV=""

# 日志级别（保留位，便于后续接结构化日志）
LOG_LEVEL="info"
